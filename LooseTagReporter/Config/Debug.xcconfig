PRODUCT_NAME = LooseTagReporter
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Empty defaults; a local Secrets.xcconfig (gitignored) overrides them when present.
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Optional include: copy Secrets.xcconfig.example → Secrets.xcconfig for local keys.
#include? "Secrets.xcconfig"

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1
